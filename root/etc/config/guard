config guard 'main'
	option enabled '1'
	# 采样间隔（秒）
	option interval '5'
	# 60 秒内命中多少个不同公网/UPnP 端口算端口扫描
	option scan_ports '5'
	# 60 秒内多少次连接公网端口算高频（只算 L 类）
	option scan_conns '30'
	# 每日汇总保留天数
	option retain_days '30'
	# 告警保留条数
	option alert_keep '5000'
	# 连接明细保留条数（24h 窗口内的上限；只含 L/U）
	option conn_keep '50000'
	# 来源 IP 归属地查询（ip-api.com，仅查 L/U 来源前 120 + 告警来源）
	option geo '1'
	# WAN 接口名；PPPoE 拨号环境是 pppoe-wan
	option wan_if 'pppoe-wan'
